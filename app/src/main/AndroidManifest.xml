<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Shared-storage access for /sdcard/astrion/dashboard.json. On the HA100
         (Android 8.1) these are classic runtime permissions, requested by
         MainActivity on launch. requestLegacyExternalStorage keeps the raw
         /sdcard path working should this ever run on Android 10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Wake the screen on motion (remote lifted/moved). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- IR Mode: blast Samsung TV codes from the HA100's built-in emitter.
         TRANSMIT_IR is a normal (install-time) permission — no runtime prompt.
         The hardware is declared required=false so the app still installs on
         a unit without an emitter; IrBlaster degrades gracefully. -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Voice assistant: capture mic audio and stream it to HA Assist.
         RECORD_AUDIO is a runtime permission, requested by MainActivity. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Keep-alive: a foreground service (KeepAliveService) so the low-memory
         killer leaves the app alone off the dock, and an exemption from
         battery optimisation so Doze doesn't cut the HA connection while the
         screen is off — either would stop the work alarm and alerts from
         arriving. FOREGROUND_SERVICE_SPECIAL_USE only matters on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AstrionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astrion"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is enabled because most local HA instances are
          reached over plain http:// on the LAN (ws://). Remove it if you only
          ever connect over https:// / wss://.
        -->

        <!-- singleTask: one instance, ever. As the home app a second copy
             would mean a second HA connection, wake word and sensor. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-app entry, OFF by default so installing never takes over
             from the stock launcher by surprise. Switched on with adb, see
             docs/POWER.md ("Making it the home app"):
               pm enable com.custom.astrion/.HomeAlias
               cmd package set-home-activity com.custom.astrion/.HomeAlias -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the Home Assistant connection open so alarms can ring" />
        </service>
    </application>
</manifest>
