on property:sys.boot_completed=1
    setprop service.adb.tcp.port 5555
    restart adbd
    start adbfw

# Re-applies the adbd port restriction on every boot. iptables rules live in
# kernel memory only, so without this the device comes back with adbd open to
# the whole LAN. Fails open, never closed: if the script cannot run, adb is
# reachable as before rather than the device being unreachable.
service adbfw /system/bin/sh /vendor/bin/adbfw.sh
    oneshot
    disabled
    seclabel u:r:su:s0
